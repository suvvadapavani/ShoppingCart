@model IEnumerable<Product>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Image</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="@item.ImagePath" width="100" />
                </td>
                <td>@item.ProductName</td>
                <td>@item.Description</td>
                <td>@item.Price</td>
                <td><a asp-action="EditProduct" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i>Edit</a></td>
                <td><a asp-action="DeleteProduct" class="btn btn btn-warning"><i class="bi bi-trash"></i>Delete</a></td>

            </tr>
        }
    </tbody>
</table>
