<div class="row align-items-center mb-3">
    <div class="col-md-6">
        <h2 class="text-secondary">Product List</h2>

        <h2 class="text-muted">Total Products:<strong>@ViewData["TotalProducts"]</strong></h2>
        <h2 class="text-muted">Latest Product:<strong>@ViewBag.LatestProduct</strong></h2>
        <h2 class="text-muted">Highest Price:<strong>@ViewBag.MaxPrice</strong></h2>

     </div>
     <div class="col-md-6 text-end" >
        <a asp-action="AddProduct" class="btn btn-dark text-white">
            <i class="bi bi-plus-circle"></i>Add Product
        </a>

     </div>

</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Image</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="@item.ImagePath" width="100" />
                </td>
                <td>@item.Id</td>
                <td>@item.ProductName</td>
                <td>@item.Description</td>
                <td>@item.Price</td>
                <td><a asp-action="EditProduct" asp-route-id="@item.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i>Edit</a></td>
                <td><a asp-action="DeleteProduct" asp-route-id="@item.Id" class="btn btn btn-warning"><i class="bi bi-trash"></i>Delete</a></td>

            </tr>
        }
    </tbody>
</table>
